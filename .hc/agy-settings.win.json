{
  "permissions": {
    "allow": [
      "command(regex:hc send .*)"
    ],
    "ask": [
      "command(regex:(.*[;&|]\\s*)?Remove-Item\\b.*)",
      "command(regex:(.*[;&|]\\s*)?rm\\s.*)",
      "command(regex:(.*[;&|]\\s*)?del\\s.*)",
      "command(regex:(.*[;&|]\\s*)?rmdir\\b.*)",
      "command(regex:(.*[;&|]\\s*)?git\\s+(push|reset|clean)\\b.*)",
      "command(regex:(.*[;&|]\\s*)?hc\\s+(kill|server)\\b.*)",
      "command(regex:(.*[;&|]\\s*)?npm\\s+publish\\b.*)",
      "command(regex:(.*[;&|]\\s*)?sudo\\b.*)"
    ]
  }
}
